{
  "name": "functions",
  "description": "Cloud Functions for PDF Reader App",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:safe": "npm run build && npm test && firebase deploy --only functions",
    "deploy:prod": "npm run build && npm test && firebase deploy --only functions --force",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "format:check": "prettier --check '**/*.{ts,js,json}' || true",
    "format:write": "prettier --write '**/*.{ts,js,json}' || true"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/googleai": "^1.0.4",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1",
    "genkit": "^1.3.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.6.3"
  },
  "private": true
}
